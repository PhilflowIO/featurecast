# Upload target for `src/upload.ts` (M6). Copy to `.env`, fill in, and keep
# that copy out of the repository — `.gitignore` already refuses it.
#
# No real endpoint, bucket, or key belongs in this file. The placeholders
# below are shapes, not values.

# Base URL of the S3-compatible store, without a bucket. Path-style
# addressing is used, so the bucket is appended to this.
FEATURECAST_S3_ENDPOINT=https://s3.example.invalid

# Region string the store expects in the signature. Garage deployments
# commonly use "garage" unless configured otherwise.
FEATURECAST_S3_REGION=your-region

# Bucket the recordings are written to.
FEATURECAST_S3_BUCKET=your-bucket

# Access key pair. These are credentials: never commit the filled-in copy.
FEATURECAST_S3_ACCESS_KEY_ID=
FEATURECAST_S3_SECRET_ACCESS_KEY=

# Optional. Base URL the uploaded object is *served* from, when that differs
# from the signing endpoint (reverse proxy, CDN). Defaults to
# <FEATURECAST_S3_ENDPOINT>/<FEATURECAST_S3_BUCKET>.
# FEATURECAST_S3_PUBLIC_BASE_URL=
