{
  "name": "featurecast",
  "version": "0.0.0",
  "description": "Turn Playwright scripts into polished product demo videos. Cursor, zoom and framing render after the recording.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PhilflowIO/featurecast.git"
  },
  "homepage": "https://github.com/PhilflowIO/featurecast#readme",
  "bugs": {
    "url": "https://github.com/PhilflowIO/featurecast/issues"
  },
  "keywords": [
    "playwright",
    "product-demo",
    "screen-recording",
    "screen-studio-alternative",
    "demo-video",
    "video-generation",
    "open-source",
    "ffmpeg",
    "typescript",
    "automation",
    "motion-design"
  ],
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "browsers:install": "playwright install chromium",
    "compare": "tsx src/compare.ts",
    "demo:hello": "tsx demo/hello.ts",
    "demo:m1-capture": "tsx demo/m1-capture.ts",
    "demo:record-smoke": "tsx demo/record-smoke.ts",
    "featurecast": "tsx src/cli.ts",
    "format": "prettier --check .",
    "lint": "eslint .",
    "montage": "tsx src/render/montage-cli.ts",
    "prepare": "simple-git-hooks",
    "render": "tsx src/render/cli.ts",
    "test": "vitest run --project portable",
    "test:all": "vitest run",
    "test:gpu": "vitest run --project gpu",
    "typecheck": "tsc --noEmit",
    "yield-bench": "tsx demo/yield-bench.ts"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged && pnpm typecheck"
  },
  "lint-staged": {
    "*": "prettier --check --ignore-unknown",
    "*.{ts,js}": "eslint --max-warnings=0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.1",
    "globals": "^15.14.0",
    "lint-staged": "^17.5.1",
    "playwright": "1.64.0-alpha-2026-09-18",
    "prettier": "^3.6.2",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^3.2.4"
  }
}
